# Copy to .env (for `npm run dev`) or pass these to the container.
# Leave a value blank if you haven't set that service up yet.
#
# Most connection settings below can instead be entered in the app (Settings →
# Connections, as an admin). A value saved in the app wins over the one here;
# "Reset" in the app goes back to this file's value. Only this file can set
# PORT, HOST, DATA_DIR, LOG_LEVEL, TRUST_PROXY and MAM_REQUIRE_INTERFACE.
#
# On first start, with no profiles yet, Lectern prints a one-time setup code in
# its log. Creating the admin profile needs it.

# Where Lectern listens
PORT=8787
HOST=0.0.0.0

# Where Lectern keeps its database and cached covers
DATA_DIR=./data

# debug | info | warn | error
LOG_LEVEL=info

# Only behind a reverse proxy (nginx, Caddy, Traefik...): the proxy's address or
# CIDR (e.g. 172.18.0.0/16), or true to trust any. Lets Lectern see visitors'
# real addresses (for sign-in limits) and https (for secure cookies).
TRUST_PROXY=

# MyAnonamouse session cookie (the value of mam_id). Lectern keeps it refreshed.
MAM_ID=
# Refuse to contact MAM unless this network interface exists (e.g. wg0 when
# Lectern shares qBittorrent's VPN). Strongly recommended for an IP-locked
# session. It protects the account, so it can only be set here, not in the app.
MAM_REQUIRE_INTERFACE=

# Which Audible store to look books up in: us, uk, ca, au, de, fr, it, es, in, jp
AUDIBLE_REGION=us
# Optional: a Google Books API key raises Google's daily lookup limit
GOOGLE_BOOKS_API_KEY=

# qBittorrent Web UI. User and password can stay blank if qBittorrent
# skips logins for local addresses.
QB_URL=
QB_USER=
QB_PASS=
# qBittorrent 5.2+: an API key (Options → Web UI → API Key). When set, it's used
# instead of QB_USER/QB_PASS, so changing the Web UI password won't break Lectern.
QB_API_KEY=
# Category for Lectern's downloads, and where qBittorrent should save them
# (as qBittorrent sees the path; blank = qBittorrent's default).
QB_CATEGORY=lectern
QB_SAVE_PATH=
# Only if qBittorrent and Lectern see the downloads under different paths:
# replace QB_PATH_FROM (qBittorrent's path) with QB_PATH_TO (Lectern's).
QB_PATH_FROM=
QB_PATH_TO=

# How finished books go into the library: hardlink (default, no extra space;
# copies instead if the library is on another drive) or copy (always a copy).
# Either way the download stays put, so qBittorrent keeps seeding.
IMPORT_MODE=hardlink

# Where finished books are filed, as Lectern sees them. Must be on the same
# drive as the downloads for hardlinks (otherwise files are copied).
# These four library values only seed the FIRST admin profile created at
# first run. After that, each profile's folders and Audiobookshelf libraries are
# set in Settings → Profiles, so two people can have separate libraries.
LIBRARY_AUDIOBOOKS_DIR=
LIBRARY_EBOOKS_DIR=

# Audiobookshelf (Settings → Users → your user → API token), plus the IDs of the
# libraries to scan after filing a book (from the library's address in ABS).
ABS_URL=
ABS_API_KEY=
ABS_AUDIOBOOKS_LIBRARY_ID=
ABS_EBOOKS_LIBRARY_ID=
