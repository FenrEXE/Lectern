# Copy to .env (for `npm run dev`) or pass these to the container.
# Leave a value blank if you haven't set that service up yet.

# Where Lectern listens
PORT=8787
HOST=0.0.0.0

# Where Lectern keeps its database and cached covers
DATA_DIR=./data

# debug | info | warn | error
LOG_LEVEL=info

# MyAnonamouse session cookie (the value of mam_id). Lectern keeps it refreshed.
MAM_ID=
# Refuse to contact MAM unless this network interface exists (e.g. wg0 when
# Lectern shares qBittorrent's VPN). Strongly recommended for an IP-locked session.
MAM_REQUIRE_INTERFACE=

# Which Audible store to look books up in: us, uk, ca, au, de, fr, it, es, in, jp
AUDIBLE_REGION=us
# Optional: a Google Books API key raises Google's daily lookup limit
GOOGLE_BOOKS_API_KEY=

# qBittorrent Web UI
QB_URL=
QB_USER=
QB_PASS=

# Audiobookshelf (Settings → Users → your user → API token)
ABS_URL=
ABS_API_KEY=
