# Copy to .env (for `npm run dev`) or pass these to the container.
# Leave a value blank if you haven't set that service up yet.

# Where Lectern listens
PORT=8787
HOST=0.0.0.0

# Where Lectern keeps its database and cached covers
DATA_DIR=./data

# debug | info | warn | error
LOG_LEVEL=info

# MyAnonamouse session cookie (the value of mam_id). Lectern keeps it refreshed.
MAM_ID=

# qBittorrent Web UI
QB_URL=
QB_USER=
QB_PASS=

# Audiobookshelf (Settings → Users → your user → API token)
ABS_URL=
ABS_API_KEY=
