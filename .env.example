# Lectern's environment. Almost everything is set in the app instead
# (Settings → Connections), so most people only need the first block.
# Values saved in the app win over these; "Reset" in the app goes back to them.

# ── Usually all you need ──
# The user that owns your library folders (run `id` on the host to see yours).
PUID=1000
PGID=1000
# Your time zone, for log times.
TZ=Etc/UTC

# ── Optional: only if your MAM session is locked to a VPN ──
# Lectern refuses to contact MAM unless this network interface exists, so it
# can never use your home IP by accident. Only set it when Lectern shares a VPN
# container's network (wg0 for hotio's qBittorrent, often tun0 for others).
# It protects your account, so it can only be set here, not in the app.
MAM_REQUIRE_INTERFACE=

# ── Optional: only behind a reverse proxy (nginx, Caddy, Traefik...) ──
# The proxy's address or CIDR (e.g. 172.18.0.0/16), or true to trust any.
TRUST_PROXY=

# ── Rarely needed ──
# PORT=8787
# HOST=0.0.0.0
# LOG_LEVEL=info          # debug | info | warn | error

# Everything below can be typed into Settings → Connections instead.
# MAM_ID=                 # your mam_id session cookie
# QB_URL=                 # e.g. http://qbittorrent:8080
# QB_API_KEY=             # qBittorrent 5.2+ (Options → Web UI → API Key)
# QB_USER=
# QB_PASS=
# QB_SAVE_PATH=           # where qBittorrent saves Lectern's downloads (qBittorrent's path)
# QB_PATH_FROM=           # only if qBittorrent and Lectern see downloads under
# QB_PATH_TO=             #   different paths: QB_PATH_FROM (qBittorrent's) → QB_PATH_TO (Lectern's)
# ABS_URL=                # e.g. http://audiobookshelf:80
# ABS_API_KEY=            # from an Audiobookshelf admin account
# GOOGLE_BOOKS_API_KEY=   # optional, raises Google's lookup limit
# AUDIBLE_REGION=us       # us, uk, ca, au, de, fr, it, es, in, jp
